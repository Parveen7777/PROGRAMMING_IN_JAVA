digraph { rankdir=LR; graph [fontname="DejaVu Sans" dpi=170 pad=0.2 bgcolor=white]; node [fontname="DejaVu Sans" fontsize=15 shape=box style="rounded,filled" fillcolor="#EAF1FB" color="#1F3A5F" penwidth=1.2]; edge [fontname="DejaVu Sans" fontsize=12 color="#1F3A5F"];
 F [label="Frame  (java.awt.Frame)\nBorderLayout\n«AppointmentDesk»" fillcolor="#FFF4D6"];
 N [label="Label\n(heading) — NORTH"]; 
 C [label="Panel  form\nGridLayout(5,2) — CENTER" fillcolor="#E3F6E8"]; 
 S [label="Panel  south\nBorderLayout — SOUTH" fillcolor="#E3F6E8"];
 F -> N; F -> C; F -> S;
 L1 [label="Label 'Patient ID'"]; T1 [label="TextField\npatientId"];
 L2 [label="Label 'Department'"]; D1 [label="Choice\ndept"];
 L3 [label="Label 'Doctor'"]; D2 [label="Choice\ndoctor"];
 L4 [label="Label 'Time slot'"]; D3 [label="Choice\nslot"];
 B1 [label="Button\nBook Appointment"]; B2 [label="Button\nClear"];
 C -> L1; C -> T1; C -> L2; C -> D1; C -> L3; C -> D2; C -> L4; C -> D3; C -> B1; C -> B2;
 ST [label="Label status\nNORTH"]; TA [label="TextArea trace\nCENTER"]; S -> ST; S -> TA;
 DL [label="Dialog (modal)\n'Confirm' — Label, Button Yes, Button No\nshown only from windowClosing" fillcolor="#FBE6E6" style="rounded,filled,dashed"]; F -> DL [style=dashed label="on close"];
